  "info": {
    "title": "QuestLog central approved-work dispatcher",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/questlog-dispatcher/": {
      "get": {
        "description": "Existing live dual-admin plus explicit owner allowlist. Private/no-store.",
        "operationId": "adminQueue",
        "responses": {
          "200": {
            "description": "Policy, registrations and bounded task queue"
          }
        }
      },
      "post": {
        "description": "Same human boundary plus CSRF. Worker signatures never grant Admin access.",
        "operationId": "adminDecision",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "expected_revision": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "operation": {
                        "const": "register"
                      },
                      "registration": {
                        "$ref": "#/components/schemas/WorkerRegistration"
                      }
                    },
                    "required": [
                      "operation",
                      "registration",
                      "expected_revision"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "operation": {
                        "const": "assign"
                      },
                      "task": {
                        "$ref": "#/components/schemas/TaskInput"
                      }
                    },
                    "required": [
                      "operation",
                      "task"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "expected_revision": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "operation": {
                        "enum": [
                          "approve",
                          "cancel"
                        ]
                      },
                      "task_id": {
                        "format": "uuid",
                        "type": "string"
                      }
                    },
                    "required": [
                      "operation",
                      "task_id",
                      "expected_revision"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "expected_revision": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "operation": {
                        "const": "set_worker_enabled"
                      },
                      "worker_id": {
                        "format": "uuid",
                        "type": "string"
                      }
                    },
                    "required": [
                      "operation",
                      "worker_id",
                      "expected_revision",
                      "enabled"
                    ],
                    "type": "object"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Owner mutation recorded"
          },
          "403": {
            "description": "Owner/admin/CSRF denied"
          },
          "409": {
            "description": "Revision/state conflict"
          }
        }
      }
    },
    "/api/v1/questlog-dispatcher/worker/": {
      "post": {
        "description": "Ed25519 signed POST. No cookies, Origin, query parameters or legacy credentials. Operation IDs are replay-safe; replays never renew execution authority.",
        "operationId": "workerOperation",
        "parameters": [
          {
            "in": "header",
            "name": "X-QuestLog-Worker-ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-QuestLog-Request-ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-QuestLog-Timestamp",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-QuestLog-Signature",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkerReply"
                }
              }
            },
            "description": "Current operation receipt, not blanket execution authority"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid closed schema"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid signature or timestamp"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Wrong worker, revoked or expired authority"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Conflict, stale fence, replay or unresolved turn"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Size bound"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limit"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Disabled or unavailable"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://questlog.casual-heroes.com"
    }
  ]
}
