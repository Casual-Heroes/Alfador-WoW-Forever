{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map_id",
    "journal_ids",
    "completed_ids",
    "position",
    "player_level",
    "limit",
    "offset"
  ],
  "properties": {
    "map_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "journal_ids": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000000
      }
    },
    "completed_ids": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000000
      }
    },
    "position": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "area_id",
            "x",
            "y"
          ],
          "properties": {
            "area_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "player_level": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    }
  }
}
